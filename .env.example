# Optional: copy to .env.local to override this repo's PC Load/Save server (server/backups.mjs).
VITE_READER_BACKUP_URL=https://192.168.1.197:7711
# If empty, the build reads ~/.local/share/manga-reader/backups/access-key, created by the server.
# The iOS builds use apps/ios/Resources/Native/BackupConfig.json (private) instead.
# Built app bundles contain this private key. Do not publish them.
VITE_READER_BACKUP_KEY=
