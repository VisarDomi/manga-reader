# Optional: copy to .env.local to override this repo's PC backup server (server/backups.mjs).
VITE_READER_BACKUP_URL=https://192.168.1.197:7711
# If empty, the build reads ~/.local/share/manga-reader/backups/access-key, created by the server.
# Built userscripts, extensions and app bundles contain this private key. Do not publish them.
VITE_READER_BACKUP_KEY=
