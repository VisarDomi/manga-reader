{
  "name": "manga-reader",
  "version": "285",
  "description": "Userscript to improve ux of supported sites",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "test:extension": "node tests/browser/extension.mjs",
    "ios:foreground": "node investigation/ios-foreground-connection.mjs",
    "test:unit": "vitest run tests/unit",
    "tests": "node tests/ios/run-fresh.mjs",
    "tests:single": "node tests/ios/run.mjs",
    "build:ios": "node scripts/build-ios.mjs",
    "test:ios:builder": "node --test apps/ios/Tests/builder.test.mjs && python3 -B apps/ios/Tests/test_signing_lock.py"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "userscript-ios-test": "file:../../userscript-ios-test",
    "vite": "^7.1.9",
    "vite-plugin-monkey": "^7.1.4",
    "vitest": "^4.1.9"
  }
}
