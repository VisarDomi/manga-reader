    "tests:setup": "python3 tests/ios/bridge_server.py --setup"
  },
  "devDependencies": {
    "@types/tampermonkey": "^5.0.4",
    "@vitest/ui": "^4.1.9",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-monkey": "^7.1.4",
    "vitest": "^4.1.9"
  }
}
