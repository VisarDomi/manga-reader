{
  "name": "manga-reader",
  "version": "192",
  "description": "Userscript to improve ux of supported sites",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "tests": "npx tsc --noEmit 2>&1 && NO_VERSION_BUMP=1 node scripts/build.mjs && node tests/ios/run.mjs",
