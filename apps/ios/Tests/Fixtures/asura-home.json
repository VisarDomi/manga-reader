], "latest_chapters": [{"id": 262148, "series_id": 0, "number": 114, "slug": "chapter-114", "page_count": 0, "is_premium": true, "comments_enabled": false, "early_access_until": "2026-10-11T19:52:50.869081Z", "published_at": "2026-10-11T13:52:50.869081Z", "view_count": 0, "created_at": "0001-01-01T00:00:00Z"}, {"id": 261871, "series_id": 0, "number": 113, "slug": "chapter-113", "page_count": 0, "is_premium": false, "comments_enabled": false, "early_access_until": "2026-09-30T15:41:56.967335Z", "published_at": "2026-09-30T09:41:56.967335Z", "view_count": 0, "created_at": "0001-01-01T00:00:00Z"}, {"id": 261714, "series_id": 0, "number": 112, "slug": "chapter-112", "page_count": 0, "is_premium": false, "comments_enabled": false, "early_access_until": "2026-09-24T11:51:50.436269Z", "published_at": "2026-09-24T05:51:50.436269Z", "view_count": 0, "created_at": "0001-01-01T00:00:00Z"}]}, {"id": 2171, "slug": "reincarnation-of-the-fist-king", "title": "Reincarnation of the Fist King", "alt_titles": ["\u62f3\u738b\u5f52\u6765", "\uad8c\uc655\ud658\uc0dd", "\u91cd\u751f\u62f3\u738b", "Reencarnaci\u00f3n del Rey del Pu\u00f1o", "\u62f3\u738b\u8ee2\u751f\uff5e\u6700\u5f37\u306e\u62f3\u738b\u304c\u308d\u304f\u3067\u306a\u3057\u516c\u5b50\u306b\u8ee2\u751f\u3057\u305f\u3089\uff5e", "\u0e01\u0e33\u0e1b\u0e31\u0e49\u0e19\u0e23\u0e32\u0e0a\u0e31\u0e19\u0e04\u0e37\u0e19\u0e0a\u0e35\u0e1e", "The Fist King's Rebirth", "Reincarnation of the Fist Lord", "Fist King Reincarnation", "Gwonwanghwansaeng", "Kwonwang Jeonsaeng", "Quy\u1ec1n V\u01b0\u01a1ng Tr\u1ecdng Sinh", "R\u00e9incarnation du Roi des Poings", "Reencarna\u00e7\u00e3o do Rei dos Punhos", "Reinkarnasi Raja Tinju", "Yumruk Kral\u0131n\u0131n Reenkarnasyonu", "\uad8c\uc655\uc804\uc0dd", "\u62f3\u738b\u8ee2\u751f", "\u62f3\u738b\u91cd\u751f", "\u0420\u0435\uc778\u043a\u0430\u0440\u043d\u0430\u0446\u0438\u044f \u041a\u043e\u0440\u043e\u043b\u044f \u041a\u0443\u043b\u0430\u043a\u043e\u0432", "\u062a\u0646\u0627\u0633\u062e \u0645\u0644\u0643 \u0627\u0644\u0642\u0628\u0636\u0629", "\u0e01\u0e32\u0e23\u0e01\u0e25\u0e31\u0e1a\u0e0a\u0e32\u0e15\u0e34\u0e21\u0e32\u0e40\u0e01\u0e34\u0e14\u0e02\u0e2d\u0e07\u0e23\u0e32\u0e0a\u0e31\u0e19\u0e22\u0e4c\u0e2b\u0e21\u0e31\u0e14"], "description": "<p>Dan Woosung, a man who once roamed the murim relying solely on his fists, met his sudden end at the hands of the demonic faction.</p><p>He then finds himself in the body of the eldest son of an affluent merchant group named Eunha.</p><p>\"I don't seek freedom from debts or grudges. Debts must be repaid. Grudges must be settled.\"</p><p>Though his new body offered only wealth, Dan Woosung rises again, backed with vast riches and the martial prowess of his previous life.</p><p>Now, he returns to the path of vengeance.</p>", "cover": "https://cdn.asurascans.com/asura-images/covers/reincarnation-of-the-fist-king.8fbafd.webp", "banner": "https://cdn.asurascans.com/asura-images/banners/reincarnation-of-the-fist-king.jpg", "status": "ongoing", "type": "manhwa", "author": "Seungtu", "artist": "MStoryHub", "popularity_rank": 57, "bookmark_count": 50440, "rating": 9.480083857442349, "chapter_count": 73, "last_chapter_at": "2026-10-11T13:45:38.670448Z", "created_at": "0001-01-01T00:00:00Z", "updated_at": "2026-10-11T15:16:09.075669Z", "public_url": "/comics/reincarnation-of-the-fist-king-bd5bdaf8", "source_url": "/s/2171", "genres": [{"id": 1, "name": "Action", "slug": "action"}, {"id": 4, "name": "Adventure", "slug": "adventure"}, {"id": 16, "name": "Fantasy", "slug": "fantasy"}, {"id": 34, "name": "Murim", "slug": "murim"}, {"id": 44, "name": "Reincarnation", "slug": "reincarnation"}, {"id": 48, "name": "Revenge", "slug": "revenge"}], "latest_chapters": [{"id": 262147, "series_id": 0, "number": 73, "title": "Sword Emperor, It Will Be Like A Dream 1", "slug": "chapter-73", "page_count": 0, "is_premium": true, "comments_enabled": false, "early_access_until": "2026-10-11T19:45:38.670448Z", "published_at": "2026-10-11T13:45:38.670448Z", "view_count": 0, "created_at": "0001-01-01T00:00:00Z"}, {"id": 261970, "series_id": 0, "number": 72, "title": "Fist King, Reaching a Different Level", "slug": "chapter-72", "page_count": 0, "is_premium": false, "comments_enabled": false, "early_access_until": "2026-10-05T02:32:44.552168Z", "published_at": "2026-10-04T20:32:44.552168Z", "view_count": 0, "created_at": "0001-01-01T00:00:00Z"}, {"id": 261788, "series_id": 0, "number": 71, "title": "The Fist King Appears as an Escort Lead", "slug": "chapter-71", "page_count": 0, "is_premium": false, "comments_enabled": false, "early_access_until": "2026-09-26T22:54:43.094574Z", "published_at": "2026-09-26T16:54:43.094574Z", "view_count": 0, "created_at": "0001-01-01T00:00:00Z"}]}, {"id": 6090, "slug": "war-of-extinction", "title": "War of Extinction", "description": "<p>Heavenly Demons. Hunters. Giant robots. Demon Kings. Superhumans.</p><p>The strongest warriors from across the multiverse have gathered in a single arena, each fighting with their entire world on the line. In this battle for survival, defeat means annihilation. Among them are the representatives of the \u201cOrdinary World\u201d\u2014the only world without powers.</p><p>Just as they are about to be crushed by monsters far beyond anything they have ever known, an unexpected weapon is granted to them.</p><p>[Game Character Abilities Synchronized.]</p><p>With the power of video-games at their command, can Shin Jahyeon and the team from the Ordinary World overcome the strongest fighters in the multiverse...</p><p>...and save their world from destruction?</p>", "cover": "https://cdn.asurascans.com/asura-images/covers/war-of-extinction.f60b25.webp", "status": "ongoing", "type": "manhwa", "popularity_rank": 82, "bookmark_count": 16253, "rating": 8.644649933949802, "chapter_count": 11, "last_chapter_at": "2026-10-11T13:38:38.441023Z", "created_at": "2026-09-16T14:28:02.61363Z", "updated_at": "2026-10-11T15:16:09.075669Z", "public_url": "/comics/war-of-extinction-bd5bdaf8", "source_url": "/s/6090", "genres": [{"id": 1, "name": "Action", "slug": "action"}, {"id": 4, "name": "Adventure", "slug": "adventure"}, {"id": 16, "name": "Fantasy", "slug": "fantasy"}], "latest_chapters": [{"id": 262146, "series_id": 0, "number": 11, "slug": "chapter-11", "page_count": 0, "is_premium": true, "comments_enabled": false, "early_access_until": "2026-10-11T19:38:38.441023Z", "published_at": "2026-10-11T13:38:38.441023Z", "view_count": 0, "created_at": "0001-01-01T00:00:00Z"}, {"id": 261902, "series_id": 0, "number": 10, "slug": "chapter-10", "page_count": 0, "is_premium": false, "comments_enabled": false, "early_access_until": "2026-10-01T09:18:50.434268Z", "published_at": "2026-10-01T03:18:50.434268Z", "view_count": 0, "created_at": "0001-01-01T00:00:00Z"}, {"id": 261897, "series_id": 0, "number": 9, "slug": "chapter-9", "page_count": 0, "is_premium": false, "comments_enabled": false, "early_access_until": "2026-10-01T00:43:46.075158Z", "published_at": "2026-09-30T18:43:46.075158Z", "view_count": 0, "created_at": "0001-01-01T00:00:00Z"}]}, {"id": 2145, "slug": "genius-prismatic-mage", "title": "Genius Prismatic Mage", "alt_titles": ["Mago prism\u00e1tico genio", "\ubb34\uc9c0\uac1c\ub97c \ubcf4\ub294 \ucc9c\uc7ac\ub9c8\ubc95\uc0ac", "\u770b\u898b\u5f69\u8679\u7684\u5929\u624d\u9b54\u6cd5\u5e2b", "\u8679\u3092\u898b\u308b\u5929\u624d\u9b54\u6cd5\u4f7f\u3044", "The Genius Prismatic Mage", "Rainbow-Colored Genius Mage", "Prismatic Genius Mage", "Rainbow Genius Wizard", "Mujigaesaek Cheonjae Mabeopsa", "Ph\u00e1p S\u01b0 Thi\u00ean T\u00e0i C\u1ea7u V\u1ed3ng", "Le G\u00e9nie Mage Prismatique", "El Genio Mago Prism\u00e1tico", "O G\u00eanio Mago Prism\u00e1tico", "Penyihir Prismatik Jenius", "\ubb34\uc9c0\uac1c\uc0c9 \ucc9c\uc7ac \ub9c8\ubc95\uc0ac", "\u8679\u8272\u306e\u5929\u624d\u9b54\u6cd5\u4f7f\u3044", "\u5f69\u8679\u8272\u7684\u5929\u624d\u9b54\u6cd5\u5e08", "\u0413\u0435\u043d\u0438\u0430\u043b\u044c\u043d\u044b\u0439 \u043f